# GitHub 飙升雷达 · 环境变量模板
# ======================================
# 用法：
#   cp .env.example .env     # 复制成 .env 再改（.env 已被 .gitignore 忽略）
#   docker compose up -d
#
# 说明：等号后面不要加引号；行内 # 注释在 docker compose 里可用。

# ------------------------------
# 服务
# ------------------------------
GH_HOST=0.0.0.0
GH_PORT=9951

# ------------------------------
# 数据库
# ------------------------------
GH_DB_HOST=db
GH_DB_PORT=5432
GH_DB_NAME=github
GH_DB_USER=postgres
# ⚠️ 生产环境务必改成强密码
GH_DB_PASSWORD=postgres
# 数据库映射到宿主机的端口
GH_DB_PORT_HOST=54321
# 连接池
GH_DB_POOL_MIN=2
GH_DB_POOL_MAX=16

# ------------------------------
# GitHub ⚠️ 敏感：只放这里，不要写进代码/文档
# ------------------------------
GH_API_BASE=https://api.github.com
# 留空也能跑，但采集限额只有 60 次/小时；填了是 5000 次/小时
GH_GITHUB_TOKEN=
# 获取：https://github.com/settings/tokens  →  Tokens (classic)
# 权限：public_repo, read:org
#
# 代理（可选，内网/受限网络才需要）

# 采集
GH_CONCURRENCY=6
GH_REQUEST_TIMEOUT=25
GH_MAX_RETRIES=3

# ------------------------------
# 统计与调度
# ------------------------------
GH_STAT_START_DATE=2025-01-01
GH_SCHEDULER_ENABLED=true
GH_DAILY_SNAPSHOT_AT=23:50
GH_WEEKLY_RANK_AT=01:00

# ------------------------------
# 管理员 ⚠️ 敏感：部署后立刻改
# ------------------------------
# 只有两个角色：普通用户（未登录，只读）/ 管理员（可执行采集等写操作）
GH_ADMIN_USER=admin
GH_ADMIN_PASSWORD=change_me_please
# 会话签名密钥：随便一串 32 位以上随机字符，务必自己生成
#   openssl rand -hex 32
GH_AUTH_SECRET=

# ------------------------------
# 默认过滤口径
# ------------------------------
GH_DEFAULT_MIN_STARS=50
GH_DEFAULT_MAX_AGE_DAYS=1095
GH_DEFAULT_PAGE_SIZE=20

# ------------------------------
# Docker 构建加速（国内网络建议保留）
# ------------------------------
PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
BASE_IMAGE=docker.1ms.run/library/python:3.12-slim
