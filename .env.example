# ===== GitHub 飙升雷达 · 环境配置模板 =====
# 复制为 .env.<环境名> 使用:  cp .env.example .env.local
# 环境约定(见 up.sh / restart.sh / docker-compose.yml):
#   .env.local → 本地开发环境 (端口 9952, DB 映射 54322, 不提交 GitHub)
#   .env.dev   → 发布/演示环境 (端口 9951, DB 映射 54321)
# 启动:  ./up.sh local | ./up.sh dev     重启:  ./restart.sh [local|dev]
# 所有 .env* 均被 .gitignore 忽略, 只提交本模板。

# ---- 环境标识 (与文件名对应, up.sh 会按环境覆盖) ----
GH_ENV=local
GH_ENV_NAME=9952

# ---- 服务 ----
GH_HOST=0.0.0.0
GH_PORT=9952
GH_DEBUG=true

# ---- 数据库 (卷为空时 initdb 自动导种子; 卷已有数据则跳过) ----
GH_DB_NAME=github
GH_DB_USER=postgres
GH_DB_PASSWORD=change-me
GH_DB_PORT_HOST=54322
GH_DB_POOL_MIN=2
GH_DB_POOL_MAX=16

# ---- GitHub 采集 (token 决定限额: 匿名 60/h, 带 token 5000/h) ----
GH_API_BASE=https://api.github.com
GH_GITHUB_TOKEN=
GH_PROXY=
GH_CONCURRENCY=6
GH_REQUEST_TIMEOUT=25
GH_MAX_RETRIES=3

# ---- 筛选默认口径 ----
GH_DEFAULT_MIN_STARS=50
GH_DEFAULT_MAX_AGE_DAYS=1095
GH_DEFAULT_PAGE_SIZE=20

# ---- 统计与调度 ----
GH_STAT_START_DATE=2025-01-01
GH_SCHEDULER_ENABLED=true
GH_DAILY_SNAPSHOT_AT=23:50
GH_WEEKLY_RANK_AT=01:00

# ---- 管理员 ----
GH_ADMIN_USER=github
GH_ADMIN_PASSWORD=change-me

# ---- LLM 模型初始化 ----
# 落盘位置 server/data/llm_config.json (bind mount, 不进 git)。
# 启动时: 文件已有供应商 → 跳过; 为空 → 用下面变量创建默认供应商。
GH_LLM_BASE_URL=https://api.example.com
GH_LLM_API_KEY=
GH_LLM_API_PREFIX=/v1
GH_LLM_MODEL=gpt-4o-mini
GH_LLM_TIMEOUT_S=120
GH_LLM_MAX_RETRIES=2

# ---- pip / 基础镜像加速(国内网络建议都填) ----
PIP_INDEX=https://mirrors.aliyun.com/pypi/simple/
BASE_IMAGE=docker.1ms.run/library/python:3.12-slim
